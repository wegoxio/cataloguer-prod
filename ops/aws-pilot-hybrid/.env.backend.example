NODE_ENV=production
PORT=3001
DATABASE_URL=postgresql://cataloguer:REPLACE_DB_PASSWORD@postgres:5432/cataloguer

# Generate every secret independently: openssl rand -hex 48
JWT_ACCESS_SECRET=REPLACE_96_HEX_CHARS
JWT_REFRESH_SECRET=REPLACE_DIFFERENT_96_HEX_CHARS
MFA_ENCRYPTION_KEY=REPLACE_WITH_64_HEX_CHARS

# Exact comma-separated origins; never use * with credentialed admin requests.
CORS_ALLOWED_ORIGINS=https://admin.catalog.wegox.io
FRONTEND_URL=https://admin.catalog.wegox.io
RATE_LIMIT_MODE=memory

STORAGE_REGION=eu-north-1
STORAGE_BUCKET=cataloguer-products-bucket
STORAGE_PUBLIC_URL=https://cataloguer-products-bucket.s3.eu-north-1.amazonaws.com
CATEGORY_STORAGE_BUCKET=cataloguer-category-images-420151437743
CATEGORY_STORAGE_PUBLIC_URL=https://cataloguer-category-images-420151437743.s3.eu-north-1.amazonaws.com
STORAGE_ACCESS_KEY_ID=REPLACE
STORAGE_SECRET_ACCESS_KEY=REPLACE

# One independent secret per storefront. Keep JSON on one line.
CATALOGUE_REVALIDATION_TARGETS=[{"name":"designhof","url":"https://www.designhof.example/api/cataloguer/revalidate","secret":"REPLACE_WITH_AT_LEAST_32_RANDOM_CHARS_1"},{"name":"client-2","url":"https://www.client2.example/api/cataloguer/revalidate","secret":"REPLACE_WITH_AT_LEAST_32_RANDOM_CHARS_2"},{"name":"client-3","url":"https://www.client3.example/api/cataloguer/revalidate","secret":"REPLACE_WITH_AT_LEAST_32_RANDOM_CHARS_3"}]

# Optional transactional email and telemetry.
RESEND_API_KEY=
MAIL_FROM=
SENTRY_DSN=

# Enable only when enterprise imports are used. This MUST be a private bucket,
# never cataloguer-products-bucket (which intentionally serves public images).
IMPORT_SOURCE_BUCKET=
IMPORT_SOURCE_ACCESS_KEY_ID=
IMPORT_SOURCE_SECRET_ACCESS_KEY=
IMPORT_SOURCE_BUCKET_PRIVATE=true
IMPORT_CONCURRENCY_PERMITS=1
