{
  "name": "cataloguer-frontend",
  "version": "0.1.0",
  "description": "Next.js frontend for the Wegox Product Catalogue Platform",
  "author": "Wegox LLC",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --dir src",
    "test:integrated": "vitest run --dir src --testTimeout=900000 --hookTimeout=900000 src/features/import-export/wizard/run/integrated-journey.test.tsx",
    "test:e2e": "playwright test",
    "test:layout": "playwright test --config=playwright.layout.config.ts",
    "test:layout:deployed": "playwright test --config=playwright.layout-prod.config.ts"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.1",
    "@sentry/nextjs": "^11.8.0",
    "@tanstack/react-query": "^5.104.3",
    "clsx": "^2.1.1",
    "lucide-react": "^1.57.0",
    "next": "^16.4.1",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.90.0",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.6.1",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.1",
    "happy-dom": "21.0.1",
    "postcss": "^8.5.30",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vitest": "^5.0.4"
  },
  "packageManager": "pnpm@11.17.0"
}
