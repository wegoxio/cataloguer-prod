# Copy to .env and fill in. Values marked SECRET must never be committed,
# pasted into chat, or emailed — share them through a password manager.
#
# .env is LOCAL DEVELOPMENT ONLY and is the only file the app auto-loads.
# Live-environment values live elsewhere — see docs/developer-guide.md §10
# ("Which file feeds which deploy"). The git-ignored .env.staging and
# .env.production are operator reference files whose variables are prefixed
# (STAGING_*/PRODUCTION_*) on purpose, so they can never feed the app.

# Server configuration
PORT=3001
NODE_ENV=development

# Database. SECRET. Supabase → Settings → Database → Connection string
# (use the POOLER string, port 6543). A local Postgres also works.
DATABASE_URL=postgresql://localhost:5432/postgres

# Authentication. Generate your own — these must NOT match anyone else's:
#   openssl rand -base64 48
# Whoever holds these can mint a token for any user, so treat them as SECRET.
JWT_ACCESS_SECRET=generate-your-own-see-comment-above
JWT_REFRESH_SECRET=generate-your-own-and-make-it-different

# Encrypts stored two-factor secrets. SECRET. Generate your own:
#   openssl rand -base64 32
# Changing it later makes existing 2FA enrolments undecryptable.
MFA_ENCRYPTION_KEY=generate-your-own-see-comment-above

# CORS origins (comma-separated allowed urls)
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Seeded admin for development/staging only. Pick your own locally.
DEV_ADMIN_EMAIL=admin@example.com
DEV_ADMIN_PASSWORD=change-me-locally

# Opt-in for POST /auth/register-dev, a local convenience to mint a low-priv
# user. OFF by default and IGNORED unless NODE_ENV=development — set to "true"
# only on your own machine. Never set it on any deployed environment.
ALLOW_DEV_REGISTER=

# Object storage for product images (optional; uploads 503 without it) — ADR 006
# AWS S3: leave STORAGE_ENDPOINT empty. Cloudflare R2: set the account endpoint.
# The two keys are SECRET: Cloudflare → R2 → Manage API Tokens. The secret is
# shown ONCE at creation. Prefer creating your own token over reusing someone
# else's, so it can be revoked independently.
STORAGE_ENDPOINT=
STORAGE_REGION=auto
STORAGE_BUCKET=product-images
STORAGE_PUBLIC_URL=https://cdn.example.com
STORAGE_ACCESS_KEY_ID=your-access-key
STORAGE_SECRET_ACCESS_KEY=your-secret-key

# One-off DesignHof catalogue import. The organization and stores must already
# exist; use their slugs (multiple store slugs are comma-separated).
DESIGNHOF_WORKBOOK=C:\path\to\DesignHof_Importacion_Productos.xlsx
DESIGNHOF_ORGANIZATION=designhof
DESIGNHOF_STORES=designhof-online
DESIGNHOF_REPORT_DIR=reports/designhof

# Email via Resend (optional). SECRET when set.
# Leave EMPTY for local work: without it, mail is logged instead of sent, so
# you cannot accidentally email real people from a dev machine.
RESEND_API_KEY=
MAIL_FROM=onboarding@resend.dev
# Optional separate HMAC secret for six-digit plan-change codes. If omitted,
# JWT_SECRET is used. Use at least 32 random bytes in production.
PLAN_CHANGE_CODE_SECRET=

# Base URL used in password-reset links (the deployed frontend)
FRONTEND_URL=http://localhost:3000

# CSV import hardening (#172). Both are validated at boot — a present-but-invalid
# value fails startup, so the protection can never silently degrade.
# MAX_IMPORT_FILE_BYTES: per-upload byte ceiling (default 5 MiB; 64 KiB–20 MiB).
# IMPORT_CONCURRENCY_PERMITS: simultaneous imports per container (default 4; 1–12).
MAX_IMPORT_FILE_BYTES=5242880
IMPORT_CONCURRENCY_PERMITS=4

# Rate limiting (#181). RATE_LIMIT_MODE selects where the throttler counters
# live. `distributed-redis` is the NORMAL scalable configuration: it shares the
# counters across every instance via Redis, so the limit stays global when the
# service scales out. `memory` = in-process counters, for local dev, tests, or
# an explicitly approved emergency rollback / single-instance deployment only.
# The mode is always explicit — NODE_ENV never selects it.
#
# In a managed production deployment (NODE_ENV=production, which the Docker image
# also sets for staging) RATE_LIMIT_MODE MUST be set explicitly — a missing value
# fails validation at boot, so a scaled service can never silently run
# per-instance limiting. In development/test a missing value defaults to memory.
# This local example is development, so memory:
RATE_LIMIT_MODE=memory
#
# The two variables below are REQUIRED and strictly validated only when
# RATE_LIMIT_MODE=distributed-redis. In memory mode a present value is
# intentionally IGNORED — no Redis client is constructed or contacted — which
# lets an operator preconfigure them before shipping distributed mode and later
# revert the mode alone (fast rollback) without removing the secret.
#
# REDIS_URL: SECRET (carries credentials). Non-loopback hosts MUST use rediss://
# (TLS); plaintext redis:// is accepted only for a loopback host (the disposable
# local acceptance test). On a runtime Redis outage the app fails CLOSED — a
# controlled HTTP 503, never an unmetered request. Left empty here (memory mode).
REDIS_URL=
#
# RATE_LIMIT_KEY_PREFIX: namespace prepended to every key so environments
# sharing one Redis database cannot collide. Lowercase colon-delimited segments
# ending in ':' (e.g. cataloguer:staging:). Required in distributed mode only.
RATE_LIMIT_KEY_PREFIX=

# Signed, best-effort fan-out to 1–20 storefronts. One line of JSON; give every
# storefront its own 32+ character secret. Production URLs must use HTTPS.
# Leave absent to use only each storefront's five-minute fallback TTL.
CATALOGUE_REVALIDATION_TARGETS=[{"name":"designhof","url":"http://localhost:3002/api/cataloguer/revalidate","secret":"replace-with-a-random-secret-at-least-32-characters"}]
